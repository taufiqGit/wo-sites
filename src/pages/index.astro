---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Story from "../components/home/Story.astro";
import Principals from "../components/home/Principals.astro";
import ServicesPreview from "../components/home/ServicesPreview.astro";
import PortfolioPreview from "../components/home/PortfolioPreview.astro";
import WhyChooseUs from "../components/home/WhyChooseUs.astro";
import ContactCta from "../components/shared/ContactCta.astro";
---

<BaseLayout
    title="OASIS Decore — Wedding Planner & Event Management"
    activeItem="home"
>
    <Hero />
    <Story />
    <Principals />
    <ServicesPreview />
    <PortfolioPreview />
    <WhyChooseUs />
    <ContactCta
        eyebrow="Mulai percakapan"
        titleLine1="Ceritamu bisa menjadi"
        titleLine2="favorit berikutnya."
        body="Ceritakan apa yang kamu bayangkan. Kami ingin mendengar hal-hal yang penting bagimu."
        ctaHref="/portofolio/#contact"
        ctaLabel="Hubungi kami"
    />
</BaseLayout>
