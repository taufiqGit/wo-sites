---
const testimonials = [
    {
        quote: "Nresnani membuat seluruh pengalaman ini terasa personal dan penuh pertimbangan. Kami benar-benar bisa menikmati momen-momen yang paling berarti bagi kami.",
        author: "Amara & Julian · The Garden Estate",
    },
    {
        quote: "Setiap pilihan terasa disengaja, setiap detail terasa seperti kami, dan hari itu berjalan dengan ketenangan yang tak akan pernah kami lupakan.",
        author: "Maya & Theo · Private residence",
    },
    {
        quote: "Mereka memahami apa yang kami inginkan bahkan sebelum kami menemukan kata-katanya. Perayaan kami terasa hangat, intim, dan sepenuhnya milik kami.",
        author: "Sofia & Elias · The Conservatory",
    },
];
---

<section class="mx-auto max-w-[1120px] px-8 py-20 sm:py-32 lg:px-0">
    <div class="mb-14">
        <p class="mb-4 text-[10px] uppercase tracking-[.3em] text-taupe">
            Kata-kata indah, kenangan yang abadi
        </p>
        <h2 class="font-serif text-4xl tracking-tight sm:text-5xl lg:text-[68px]">
            Apa yang pasangan kami
            <br />
            <i>paling ingat.</i>
        </h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
        {testimonials.map((item) => (
            <figure class="rounded-[4px] bg-[#ebe2d7] p-7 shadow-card">
                <span class="font-serif text-5xl text-champagne">&ldquo;</span>
                <blockquote class="mt-3 text-[15px] leading-8 text-espresso/75">
                    {item.quote}
                </blockquote>
                <figcaption class="mt-8 text-[10px] uppercase tracking-[.2em] text-taupe">
                    {item.author}
                </figcaption>
            </figure>
        ))}
    </div>
</section>
