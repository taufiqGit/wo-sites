---
---

<section id="gallery" class="bg-[#ebe2d7] px-8 py-20 sm:py-28 lg:px-16">
    <div class="mx-auto max-w-[1280px]">
        <div class="flex flex-col justify-between gap-7 lg:flex-row lg:items-end">
            <div>
                <p class="mb-4 text-[10px] uppercase tracking-[.3em] text-taupe">
                    Kumpulan perayaan
                </p>
                <h2 class="font-serif text-4xl tracking-tight sm:text-5xl lg:text-[68px]">
                    Pernikahan dengan
                    <br />
                    <i>ritmenya sendiri.</i>
                </h2>
            </div>
            <p class="max-w-[290px] text-sm leading-7 text-espresso/60">
                Koleksi penuh pertimbangan dari perjumpaan intim, perayaan
                klasik, dan detail yang bermakna.
            </p>
        </div>

        <div class="mt-16 grid grid-cols-12 gap-5">
            <article class="group col-span-12 md:col-span-7">
                <div class="h-[400px] overflow-hidden rounded-[4px] bg-taupe shadow-card sm:h-[500px]">
                    <img
                        src="https://images.unsplash.com/photo-1465495976277-4387d4b0e4a6?auto=format&fit=crop&w=1400&q=85"
                        alt="Perayaan pernikahan outdoor yang abadi"
                        class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                        loading="lazy"
                    />
                </div>
                <div class="flex justify-between gap-4 pt-5">
                    <div>
                        <h3 class="font-serif text-2xl sm:text-3xl">
                            Perayaan yang Abadi
                        </h3>
                        <p class="mt-2 text-[10px] uppercase tracking-[.2em] text-taupe">
                            The Garden Estate · Keanggunan klasik
                        </p>
                    </div>
                    <span class="font-serif text-2xl italic text-taupe">
                        01
                    </span>
                </div>
            </article>

            <div class="col-span-12 grid grid-cols-2 gap-5 md:col-span-5 md:grid-cols-1 md:grid-rows-2">
                <article class="group">
                    <div class="h-[180px] overflow-hidden rounded-[4px] shadow-card sm:h-[235px]">
                        <img
                            src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1000&q=85"
                            alt="Pasangan pernikahan intim berjalan bersama"
                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>
                    <div class="pt-4">
                        <h3 class="font-serif text-xl sm:text-2xl">
                            Acara yang Intim
                        </h3>
                        <p class="mt-1 text-[10px] uppercase tracking-[.2em] text-taupe">
                            Private residence · Pernikahan taman
                        </p>
                    </div>
                </article>
                <article class="group">
                    <div class="h-[180px] overflow-hidden rounded-[4px] shadow-card sm:h-[235px]">
                        <img
                            src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1000&q=85"
                            alt="Resepsi pernikahan malam dengan lilin"
                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>
                    <div class="pt-4">
                        <h3 class="font-serif text-xl sm:text-2xl">
                            Malam yang Tak Terlupakan
                        </h3>
                        <p class="mt-1 text-[10px] uppercase tracking-[.2em] text-taupe">
                            The Conservatory · Resepsi megah
                        </p>
                    </div>
                </article>
            </div>

            <article class="group col-span-12 mt-5 grid items-center gap-8 rounded-[4px] bg-espresso p-5 text-ivory shadow-card md:grid-cols-[.9fr_1.1fr] md:p-7">
                <div class="h-[300px] overflow-hidden rounded-[3px]">
                    <img
                        src="https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&w=1000&q=85"
                        alt="Detail pernikahan budaya dan bunga"
                        class="h-full w-full object-cover"
                        loading="lazy"
                    />
                </div>
                <div class="px-2 py-5 md:px-8">
                    <p class="mb-5 text-[10px] uppercase tracking-[.3em] text-champagne">
                        04 — Detail yang bermakna
                    </p>
                    <h3 class="font-serif text-4xl leading-[1.02] sm:text-5xl">
                        Berakar pada
                        <br />
                        <i>tradisi.</i>
                    </h3>
                    <p class="mt-6 max-w-[390px] text-sm leading-7 text-ivory/65">
                        Perayaan yang dibentuk oleh keluarga, budaya, dan detail
                        yang membuat pernikahan terasa sangat personal.
                    </p>
                    <p class="mt-6 text-[10px] uppercase tracking-[.2em] text-champagne">
                        Perayaan budaya · Detail yang bermakna
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>
