---
const services = [
    {
        number: "01 — FULL WEDDING PLANNING",
        title: "Dari nol menjadi perayaan.",
        body: "Perencanaan komprehensif: konsep, anggaran, vendor, pendampingan fitting, hingga koordinasi hari-H.",
        image: "https://images.unsplash.com/photo-1507504031003-b417219a0fde?auto=format&fit=crop&w=900&q=85",
        alt: "Aisle upacara yang elegan dengan bunga putih",
        offset: false,
    },
    {
        number: "02 — DECORATION & AMBIENCE",
        title: "Dekorasi bernilai seni tinggi.",
        body: "Penataan dekorasi dan tata cahaya sesuai tema impian Anda, di bawah arahan lead designer berpengalaman.",
        image: "https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=900&q=85",
        alt: "Meja pernikahan ivory dengan lilin dan bunga",
        offset: true,
    },
    {
        number: "03 — WEDDING DAY COORDINATION",
        title: "Setiap momen di tempatnya.",
        body: "Pendampingan fokus pada hari-H agar seluruh acara berlangsung mulus sesuai rundown.",
        image: "https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=900&q=85",
        alt: "Detail resepsi disiapkan sebelum tamu datang",
        offset: false,
    },
];
---

<section id="services" class="bg-[#ebe2d7] px-8 py-20 sm:py-28 lg:px-16">
    <div class="mx-auto max-w-[1280px]">
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
            <div>
                <p class="mb-4 text-[10px] uppercase tracking-[.3em] text-taupe">
                    Bagaimana kami membantu
                </p>
                <h2 class="font-serif text-4xl leading-[1.02] tracking-tight sm:text-5xl lg:text-[68px]">
                    Dirancang sesuai
                    <br />
                    <i>keindahan versimu.</i>
                </h2>
            </div>
            <p class="max-w-[270px] text-sm leading-6 text-espresso/60">
                Dari ide pertama hingga akhir acara, setiap lapisan perayaanmu
                kami rawat dengan penuh niat baik.
            </p>
        </div>

        <div class="mt-16 grid gap-7 md:grid-cols-3">
            {services.map((service) => (
                <article
                    class:list={[
                        "group rounded-[4px] bg-ivory p-4 shadow-card transition-transform duration-500 hover:-translate-y-2",
                        { "md:mt-12": service.offset },
                    ]}
                >
                    <div class="h-[330px] overflow-hidden rounded-[2px]">
                        <img
                            src={service.image}
                            alt={service.alt}
                            class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                            loading="lazy"
                        />
                    </div>
                    <div class="px-3 pb-4 pt-7">
                        <p class="text-[10px] tracking-[.22em] text-taupe">
                            {service.number}
                        </p>
                        <h3 class="mt-3 font-serif text-3xl">
                            {service.title}
                        </h3>
                        <p class="mt-4 text-sm leading-6 text-espresso/65">
                            {service.body}
                        </p>
                        <a
                            href="/services/"
                            class="mt-6 inline-flex text-[10px] uppercase tracking-[.2em] underline decoration-champagne underline-offset-8"
                        >
                            Pelajari lebih lanjut
                        </a>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
