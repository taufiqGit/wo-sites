---
---

<section
    id="portfolio"
    class="mx-auto max-w-[1280px] px-8 py-24 sm:py-32 lg:px-0"
>
    <div class="flex flex-col justify-between gap-7 lg:flex-row lg:items-end">
        <div>
            <p class="mb-4 text-[10px] uppercase tracking-[.3em] text-taupe">
                Perayaan pilihan
            </p>
            <h2 class="font-serif text-4xl tracking-tight sm:text-5xl lg:text-[68px]">
                Kumpulan
                <br />
                <i>cerita cinta.</i>
            </h2>
        </div>
        <a
            href="/portofolio/"
            class="text-[10px] uppercase tracking-[.22em] underline decoration-champagne underline-offset-8"
        >
            Lihat portofolio lengkap →
        </a>
    </div>

    <div class="mt-16 grid grid-cols-12 gap-5">
        <div class="col-span-12 h-[420px] overflow-hidden rounded-[4px] sm:h-[480px] md:col-span-7">
            <img
                src="https://images.unsplash.com/photo-1465495976277-4387d4b0e4a6?auto=format&fit=crop&w=1400&q=85"
                alt="Couple celebrating beneath trees"
                class="h-full w-full object-cover"
                loading="lazy"
            />
        </div>
        <div class="col-span-12 grid grid-cols-2 gap-5 md:col-span-5 md:grid-cols-1 md:grid-rows-2">
            <div class="h-[230px] overflow-hidden rounded-[4px] md:h-auto">
                <img
                    src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1000&q=85"
                    alt="Meja pernikahan dengan lilin"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
            </div>
            <div class="h-[230px] overflow-hidden rounded-[4px] md:h-auto">
                <img
                    src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1000&q=85"
                    alt="Newlyweds walking together"
                    class="h-full w-full object-cover"
                    loading="lazy"
                />
            </div>
        </div>
    </div>

    <div class="mt-6 flex flex-col justify-between gap-3 text-[10px] uppercase tracking-[.2em] text-taupe sm:flex-row">
        <span>Perayaan yang abadi · The Garden Estate</span>
        <span>Acara yang intim · Private residence</span>
    </div>
</section>
