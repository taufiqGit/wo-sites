---
const steps = [
    {
        number: "01",
        title: "Konsultasi Awal",
        body: "Diskusi awal untuk memahami impian, gaya, dan anggaran Anda.",
    },
    {
        number: "02",
        title: "Konsep & Budgeting",
        body: "Penyusunan ide visual, penentuan moodboard, serta pembagian alokasi anggaran secara transparan.",
    },
    {
        number: "03",
        title: "Kurasi Vendor",
        body: "Memilih dan mengoordinasikan vendor terbaik (dekorasi, katering, dokumentasi, gaun, dll).",
    },
    {
        number: "04",
        title: "Eksekusi Hari-H",
        body: "Gladi bersih (rehearsal), finalisasi rundown, dan koordinasi seluruh panitia/vendor.",
    },
];
---

<section
    id="process"
    class="mx-auto max-w-[1120px] px-8 py-20 sm:py-32 lg:px-0"
>
    <div class="mb-16 max-w-[650px]">
        <p class="mb-5 text-[10px] uppercase tracking-[.3em] text-taupe">
            Cara kami bekerja
        </p>
        <h2 class="font-serif text-4xl leading-[1.04] tracking-tight sm:text-5xl lg:text-[68px]">
            Empat langkah menuju
            <br />
            <i>hari besar Anda.</i>
        </h2>
    </div>
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((step) => (
            <div class="border-t border-espresso/25 pt-6">
                <span class="font-serif text-3xl italic text-champagne">
                    {step.number}
                </span>
                <h3 class="mt-5 font-serif text-2xl">{step.title}</h3>
                <p class="mt-4 text-sm leading-7 text-espresso/65">
                    {step.body}
                </p>
            </div>
        ))}
    </div>
</section>
