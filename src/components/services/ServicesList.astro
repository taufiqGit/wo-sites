        items: [
            "Menu tradisional & nusantara",
            "International buffet & food stall",
            "Higienis & disajikan estetik",
            "Bisa disesuaikan dengan tema acara",
        ],
        cta: "Konsultasi katering",
        image: "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=900&q=85",
        alt: "Sajian katering pernikahan yang tertata",
        offset: false,
    },
    {
        number: "06 — DECORATION & AMBIENCE DESIGN",
        title: "Dekorasi bernilai seni tinggi.",
        body: "Penataan dekorasi dan tata pencahayaan bernilai seni tinggi yang disesuaikan dengan tema impian Anda, ditangani langsung di bawah arahan lead designer berpengalaman.",
        items: [
            "Desain dekorasi sesuai tema",
            "Tata pencahayaan & ambience",
            "Arahan langsung lead designer",
            "Instalasi & perapian di lokasi",
        ],
        cta: "Konsultasi dekorasi",
        image: "https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=900&q=85",
        alt: "Dekorasi resepsi yang tertata indah",
        offset: true,
    },
