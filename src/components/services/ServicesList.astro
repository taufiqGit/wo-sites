    {
        number: "01 — FULL WEDDING PLANNING",
        title: "Dari nol menjadi perayaan.",
        body: "Perencanaan komprehensif dari nol. Mulai dari penentuan konsep, manajemen anggaran, pemilihan vendor, pendampingan fitting, hingga koordinasi di hari-H.",
        items: [
            "Penentuan konsep & moodboard",
            "Manajemen anggaran transparan",
            "Pemilihan & koordinasi vendor",
            "Pendampingan fitting & koordinasi hari-H",
        ],
        cta: "Konsultasi full planning",
        image: "https://images.unsplash.com/photo-1507504031003-b417219a0fde?auto=format&fit=crop&w=900&q=85",
        alt: "Upacara pernikahan dengan bunga putih yang elegan",
        offset: false,
    },
    {
        number: "02 — PARTIAL WEDDING PLANNING",
        title: "Melengkapi rencanamu.",
        body: "Untuk pasangan yang sudah memiliki beberapa vendor sendiri, namun membutuhkan bantuan profesional untuk melengkapi dan memfinalisasi perencanaan.",
        items: [
            "Evaluasi rencana yang sudah berjalan",
            "Rekomendasi vendor untuk kebutuhan tersisa",
            "Penyusunan rundown & linimasa",
            "Finalisasi anggaran",
        ],
        cta: "Konsultasi partial planning",
        image: "https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=900&q=85",
        alt: "Meja linen ivory berlapis dengan lilin",
        offset: true,
    },
    {
        number: "03 — WEDDING DAY COORDINATION (WO)",
        title: "Setiap momen di tempatnya.",
        body: "Pendampingan fokus pada hari-H (serta persiapan akhir 1-2 bulan sebelumnya) untuk memastikan seluruh jalannya acara berlangsung mulus dan sesuai rundown.",
        items: [
            "Persiapan akhir 1-2 bulan sebelum hari-H",
            "Gladi bersih & finalisasi rundown",
            "Koordinasi seluruh panitia & vendor",
            "Pengawasan jalannya acara di hari-H",
        ],
        cta: "Konsultasi wedding coordinator",
        image: "https://images.unsplash.com/photo-1478146896981-b80fe463b330?auto=format&fit=crop&w=900&q=85",
        alt: "Detail resepsi disiapkan sebelum tamu datang",
        offset: false,
    },
    {
        number: "04 — MAKE UP & BEAUTY STYLING",
        title: "Pesona terbaik di hari besar.",
        body: "Layanan rias pengantin (Bride & Groom Make Up), rias keluarga, serta penataan busana adat maupun modern oleh Make Up Artist profesional.",
        items: [
            "Bride & groom make up",
            "Rias keluarga & orang tua",
            "Penataan busana adat maupun modern",
            "MUA profesional berpengalaman",
        ],
        cta: "Konsultasi make up & styling",
        image: "https://images.unsplash.com/photo-1522337660859-02fbefca4702?auto=format&fit=crop&w=900&q=85",
        alt: "Pengantin wanita saat sesi rias makeup",
        offset: false,
    },
    {
